{
  "name": "wind-map",
  "private": true,
  "type": "module",
  "description": "Animated wind map you can zoom, save as an image and print.",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.node.json",
    "build:borders": "node data/build-borders.ts",
    "test": "tsc -p . && node tests/smoke.ts"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-simplify": "3.0.3",
    "playwright": "1.56.1",
    "topojson-client": "3.1.0",
    "topojson-simplify": "3.0.3",
    "typescript": "7.0.2",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2"
  }
}
